# Copy to .env.local. Never prefix these with NEXT_PUBLIC_.
# Comma-separated access codes for the demo link
ACCESS_CODES=demo-2026
# Hard cap per session in seconds; keep it at or under the Tavus plan limit
SESSION_CAP_SECONDS=300
# For the AI summary (not connected yet)
ANTHROPIC_API_KEY=

# Email on every conversation, sent from your Gmail by apps-script/Code.gs.
# The web app URL from Deploy (ends in /exec). Leave empty to turn emails off.
NOTIFY_WEBHOOK_URL=
# Same value as the script's NOTIFY_SECRET property
NOTIFY_WEBHOOK_SECRET=
# Any long random string; signs the ticket that lets a session send its email
SESSION_SECRET=
